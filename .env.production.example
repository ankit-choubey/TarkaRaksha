# ==============================================================================
# TarkaRaksha Production Environment Variables Template
# ==============================================================================

# Razorpay Test / Live Credentials
# Obtain from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Groq Llama 3.3 Versatile API Key (Advisory AI Parsing)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend Public Backend Pointer (Set on your frontend host)
# e.g., https://tarkaraksha-backend.onrender.com
NEXT_PUBLIC_API_URL=https://tarkaraksha-backend.onrender.com
